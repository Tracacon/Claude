{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tracacon-app",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // Im Cloudflare-Dashboard eingetragene Werte (z. B. Impressumsangaben OPERATOR_…) beim Veröffentlichen behalten
  "keep_vars": true,
  // Odoo (Termine) und Instagram. Die Geheimnisse ODOO_API_KEY, SUPABASE_SECRET_KEY und
  // INSTAGRAM_TOKEN werden nur im Cloudflare-Dashboard als "Secret" eingetragen, nie hier.
  // Optional: "INSTAGRAM_AUTHOR" = Nickname, unter dem die Instagram-Beiträge erscheinen
  // (sonst die erste Verwaltung).
  "vars": {
    "ODOO_URL": "https://tracacon.odoo.com",
    "ODOO_PUBLIC_URL": "https://www.tracacon.de",
    // Instagram-Konto tracacon.de (ID aus der Meta-App „TRACACON Community App“)
    "INSTAGRAM_USER_ID": "17841477767684437"
  },
  // Staging: eigener Worker und eigenes Supabase-Projekt
  "env": {
    "staging": {
      "name": "tracacon-app-staging"
    }
  }
}

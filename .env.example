# Vorlage: als .env.local kopieren (lokal) bzw. als Variablen bei Cloudflare hinterlegen.
# Echte Werte nie ins Repository einchecken.

# --- Supabase (öffentlich, landet beim Bauen in der App) -------------------
# Supabase → Projekt → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Betreiber für das Impressum (nur auf dem Server) ----------------------
# Beim Wechsel zur UG nur diese Werte ändern.
OPERATOR_NAME=
OPERATOR_LEGAL_FORM=
OPERATOR_STREET=
OPERATOR_CITY=
OPERATOR_EMAIL=
OPERATOR_PHONE=
OPERATOR_REPRESENTATIVE=
OPERATOR_REGISTER=
OPERATOR_VAT_ID=
